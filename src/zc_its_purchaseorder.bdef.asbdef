projection;
strict ( 2 );
use draft;

define behavior for ZC_ITS_PURCHASEORDER alias PurchaseOrder
{
  use create; use update; use delete;
  use association _Item { create; }
  use action Submit; use action Approve; use action Reject; use action Cancel; use action Receive;
  use action Edit; use action Activate; use action Discard; use action Resume; use action Prepare;
}

  define behavior for ZC_ITS_PURCHASEORDERITEM alias PurchaseOrderItem
  {
    use update; use delete;
    use association _PurchaseOrder;
  }