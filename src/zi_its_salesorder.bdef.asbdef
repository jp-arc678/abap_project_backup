managed implementation in class zbp_i_its_salesorder unique;
strict ( 2 );
with draft;

define behavior for ZI_ITS_SALESORDER alias SalesOrder
persistent table zits_so
draft table zits_so_d
lock master total etag LastChangedAt
etag master LocalLastChangedAt
authorization master ( global )
{
  create ( authorization : global );
  update ( features : instance );
  delete ( features : instance );
  association _Item { create; }

  field ( readonly, numbering : managed ) SOUUID;
  // SubtotalAmount, DiscountPercent and DiscountAmount are computed by
  // calcTotalAmount / calcOrderDiscount - only PromoID is user input.
  field ( readonly ) SONumber, OrderType, OverallStatus, ApprovalLevel, TotalAmount,
                     SubtotalAmount, DiscountPercent, DiscountAmount,
                     ApprovedBy, ApprovedAt, SalespersonID, BranchID,
                     CreatedBy, CreatedAt, LocalLastChangedBy, LocalLastChangedAt, LastChangedAt;

  determination setHeaderDefaults on modify { create; }
  determination assignSONumber on save { create; }

  // The order discount has two ways of becoming stale: the items change
  // (handled by SalesOrderItem~calcTotalAmount) or the chosen promotion
  // changes (handled here). Both call the same recalculation, so the two
  // paths cannot drift apart.
  //
  // Triggers on PromoID only - never on SubtotalAmount, DiscountAmount or
  // TotalAmount, which is what this determination writes (hard-won rule 3).
  determination calcOrderDiscount on modify { field PromoID; }


  validation validateItems       on save { create; update; }
  validation validateBranch      on save { create; update; field BranchID; }
  validation validateSalesperson on save { create;         field SalespersonID; }
  validation validateCreatorRole on save { create; }

  // CustomerID is deliberately NOT field ( mandatory ) - a blank customer is
  // a valid walk-in sale. The validation only bites when one IS entered.
  validation validateCustomer    on save { create; update; field CustomerID; }

  // Order-level promotion: type, validity and threshold. Optional field,
  // so it only bites when a promotion was actually chosen.
  validation validateOrderPromo  on save { create; update; field PromoID; }

  action ( features : instance ) Submit   result [1] $self;
  action ( features : instance ) Approve  result [1] $self;
  action ( features : instance ) Reject   result [1] $self;
  action ( features : instance ) Cancel   result [1] $self;
  action ( features : instance ) Complete result [1] $self;
  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare
  {
    validation validateItems;
    validation validateBranch;
    validation validateSalesperson;
    validation validateCreatorRole;
    validation validateCustomer;
    validation validateOrderPromo;
    validation SalesOrderItem~validateItemPromo;
    validation SalesOrderItem~validateQuantity;
    validation SalesOrderItem~validateStock;
  }
  mapping for zits_so
  {
    SOUUID             = so_uuid;
    SONumber           = so_number;
    BranchID           = branch_id;
    OrderType          = order_type;
    OverallStatus      = overall_status;
    ApprovalLevel      = approval_level;
    SalespersonID      = salesperson_id;
    SalesDate          = sales_date;
    TotalAmount        = total_amount;
    CurrencyCode       = currency_code;
    PaymentMethod      = payment_method;
    CustomerID         = customer_id;
    SubtotalAmount     = subtotal_amount;
    PromoID            = promo_id;
    DiscountPercent    = discount_percent;
    DiscountAmount     = discount_amount;
    ApprovedBy         = approved_by;
    ApprovedAt         = approved_at;
    RejectionReason    = rejection_reason;
    CreatedBy          = created_by;
    CreatedAt          = created_at;
    LocalLastChangedBy = local_last_changed_by;
    LocalLastChangedAt = local_last_changed_at;
    LastChangedAt      = last_changed_at;
  }
}

 define behavior for ZI_ITS_SALESORDERITEM alias SalesOrderItem
 persistent table zits_soitem
 draft table zits_soitem_d
 lock dependent by _SalesOrder
 authorization dependent by _SalesOrder
 etag master LocalLastChangedAt
 {
   update ( features : instance );
   delete ( features : instance );
   association _SalesOrder;

   field ( readonly, numbering : managed ) SOItemUUID;
   // CostPrice is a snapshot of what the product cost at the moment of sale,
   // taken by fetchProductData - never typed, never refreshed afterwards
   // DiscountPercent and DiscountAmount are computed by fetchProductData
   // from the chosen promotion - only PromoID is user input.
   field ( readonly ) ParentUUID, Amount, CostPrice, DiscountPercent, DiscountAmount,
                      LocalLastChangedAt;

   // PromoID joins the trigger list: choosing or clearing a promotion has
   // to recompute the line's discount and net Amount, exactly as changing
   // the quantity does.
   determination fetchProductData on modify { field ProductID, Quantity, PromoID; }
   determination calcTotalAmount   on modify { field Quantity, SalePrice, PromoID; create; delete;}
   validation validateQuantity on save { create; update; field Quantity; }
   validation validateStock on save { create; update; field ProductID, Quantity; }
   validation validateItemPromo on save { create; update; field PromoID; }
   mapping for zits_soitem
   {
     SOItemUUID         = soitem_uuid;
     ParentUUID         = parent_uuid;
     ItemPos            = item_pos;
     ProductID          = product_id;
     Quantity           = quantity;
     Unit               = unit;
     SalePrice          = sale_price;
     CostPrice          = cost_price;
     PromoID            = promo_id;
     DiscountPercent    = discount_percent;
     DiscountAmount     = discount_amount;
     Amount             = amount;
     CurrencyCode       = currency_code;
     LocalLastChangedAt = local_last_changed_at;
   }
 }