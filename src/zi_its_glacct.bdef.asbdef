managed implementation in class zbp_i_its_glacct unique;
strict ( 2 );
with draft;

define behavior for ZI_ITS_GLACCT alias glaccount
persistent table zits_glacct
draft table zits_glacct_d
lock master total etag LastChangedAt
etag master LocalLastChangedAt
authorization master ( global )
//etag master <field_name>
{
  create ( authorization : global );
  update;
  delete;
  field ( readonly )  glaccount;

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;
}