@EndUserText.label: 'Financial reporting service'
define service ZUI_ITS_FINREPORT {
  expose ZI_ITS_TRIAL_BALANCE as TrialBalance;
  expose ZI_ITS_PL_BY_BRANCH  as ProfitAndLoss;
  expose ZI_ITS_CASH_POSITION as CashPosition;

  // 'APAging', not 'Aging': OData names the entity type <EntitySet>Type,
  // and nothing here is called APAgingType. Checked, not assumed.
  expose ZI_ITS_AP_AGING      as APAging;
}
