@Metadata.layer: #CORE

@UI: {
  headerInfo: {
    typeName: 'Sales Order',
    typeNamePlural: 'Sales Orders',
    title:       { type: #STANDARD, value: 'SONumber' },
    description: { type: #STANDARD, value: 'OverallStatus' }
  }
}

annotate view ZC_ITS_SALESORDER with
{
  @UI.facet: [
    { id: 'General', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE,
      label: 'General Information', position: 10 },
    { id: 'Items',   purpose: #STANDARD, type: #LINEITEM_REFERENCE,
      label: 'Items', position: 20, targetElement: '_Item' }
  ]
  @UI.hidden: true
  SOUUID;

  @UI: {
    lineItem: [ { position: 10, importance: #HIGH },
                { type: #FOR_ACTION, dataAction: 'Submit',   label: 'Submit' },
                { type: #FOR_ACTION, dataAction: 'Approve',  label: 'Approve' },
                { type: #FOR_ACTION, dataAction: 'Reject',   label: 'Reject' },
                { type: #FOR_ACTION, dataAction: 'Cancel',   label: 'Cancel' },
                { type: #FOR_ACTION, dataAction: 'Complete', label: 'Complete' } ],
    identification: [ { position: 10 },
                { type: #FOR_ACTION, dataAction: 'Submit',   label: 'Submit' },
                { type: #FOR_ACTION, dataAction: 'Approve',  label: 'Approve' },
                { type: #FOR_ACTION, dataAction: 'Reject',   label: 'Reject' },
                { type: #FOR_ACTION, dataAction: 'Cancel',   label: 'Cancel' },
                { type: #FOR_ACTION, dataAction: 'Complete', label: 'Complete' } ],
    selectionField: [ { position: 10 } ]
  }
  SONumber;

  @UI: { lineItem:       [ { position: 15, importance: #HIGH } ],
         identification: [ { position: 15 } ],
         selectionField: [ { position: 15 } ] }
  BranchID;

  @UI.hidden: true
  BranchName;

  @UI: { lineItem:       [ { position: 20, importance: #MEDIUM } ],
         identification: [ { position: 20 } ],
         textArrangement: #TEXT_FIRST }
  SalespersonID;

  @UI.hidden: true
  SalespersonName;

  @UI: { lineItem:       [ { position: 30, importance: #MEDIUM } ],
         identification: [ { position: 30 } ] }
  SalesDate;

  @UI: { lineItem:       [ { position: 40, importance: #HIGH } ],
         identification: [ { position: 40 } ] }
  TotalAmount;

  @UI: { identification: [ { position: 45 } ] }
  CurrencyCode;

  @UI: { lineItem:       [ { position: 47, importance: #LOW } ],
         identification: [ { position: 47 } ],
         selectionField: [ { position: 47 } ] }
  PaymentMethod;

  @UI: { lineItem:       [ { position: 50, importance: #LOW } ],
         identification: [ { position: 50 } ],
         selectionField: [ { position: 50 } ] }
  OrderType;

  @UI: {
    lineItem:       [ { position: 60, importance: #HIGH, criticality: 'StatusCriticality' } ],
    identification: [ { position: 60 } ],
    selectionField: [ { position: 60 } ]
  }
  OverallStatus;

  @UI.hidden: true
  OverallStatusText;
  @UI.hidden: true
  StatusCriticality;

  @UI: { identification: [ { position: 65 } ] }
  ApprovalLevel;

  @UI: { identification: [ { position: 70 } ] }
  RejectionReason;

  @UI.hidden: true
  ApprovedBy;
  @UI.hidden: true
  ApprovedAt;
}