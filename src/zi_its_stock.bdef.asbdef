managed implementation in class zbp_i_its_stock unique;
strict ( 2 );

define behavior for ZI_ITS_STOCK alias Stock
persistent table zits_stock
lock master
authorization master ( global )
etag master LocalLastChangedAt
{
  create;
  update;
  delete;

  // NOTE: QtyOnHand is intentionally NOT declared readonly — SalesOrder/PurchaseOrder
  // write it via EML (Complete/Receive actions). field(readonly) here would block that (see CLAUDE.md §7.2).

  //--- field characteristics ---
  field ( mandatory : create, readonly : update ) BranchID, ProductID;
  field ( readonly ) StockCriticality,CreatedBy, CreatedAt, LocalLastChangedBy, LocalLastChangedAt, LastChangedAt;

  //--- determinations ---
  determination setDefaults      on modify { create; }
  determination setMovementDate  on modify { field QtyOnHand; }

  //--- validations ---
  validation validateBranch  on save { create;         field BranchID; }
  validation validateProduct on save { create;         field ProductID; }
  validation validateQty     on save { create; update; field QtyOnHand, QtyReserved; }

  mapping for zits_stock
  {
    BranchID           = branch_id;
    ProductID          = product_id;
    QtyOnHand          = qty_on_hand;
    QtyReserved        = qty_reserved;
    ReorderLevel       = reorder_level;
    Unit               = unit;
    LastMovementDate   = last_movement_date;
    CreatedBy          = created_by;
    CreatedAt          = created_at;
    LocalLastChangedBy = local_last_changed_by;
    LocalLastChangedAt = local_last_changed_at;
    LastChangedAt      = last_changed_at;
  }
}