managed implementation in class zbp_i_its_employee unique;
strict ( 2 );
with draft;

define behavior for ZI_ITS_EMPLOYEE alias Employee
persistent table zits_employee
draft table zits_employee_d
lock master total etag LastChangedAt
etag master LocalLastChangedAt
authorization master ( global )
{
  create;
  update;
  // ไม่มี delete โดยตั้งใจ — ใช้ IsActive = ' ' เพื่อปิดการใช้งานแทน

  //--- field characteristics ---
  field ( mandatory : create, readonly : update ) EmployeeID;
  field ( mandatory ) EmployeeName, RoleCode, UserName;
  // RegionID is NOT readonly: a regional manager ('R') is scoped by region
  // instead of by branch, so it has to be typeable. validateScope is what
  // decides when it is required and when it must stay empty.
  field ( readonly ) RoleName, CreatedBy, CreatedAt,
                     LocalLastChangedBy, LocalLastChangedAt, LastChangedAt;

  //--- determinations ---
  determination setDefaults on modify { create; }

  //--- validations ---
  validation validateEmployeeID on save { create;         field EmployeeID; }
  validation validateRole       on save { create; update; field RoleCode, IsActive; }
  validation validateUserName   on save { create; update; field UserName; }
  validation validateScope      on save { create; update; field RoleCode, BranchID, RegionID; }

  //--- draft actions ---
  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare
  {
    validation validateEmployeeID;
    validation validateRole;
    validation validateUserName;
    validation validateScope;
  }

  mapping for zits_employee
  {
    EmployeeID         = employee_id;
    EmployeeName       = employee_name;
    BranchID           = branch_id;
    RegionID           = region_id;
    RoleCode           = role_code;
    UserName           = user_name;
    IsActive           = is_active;
    CreatedBy          = created_by;
    CreatedAt          = created_at;
    LocalLastChangedBy = local_last_changed_by;
    LocalLastChangedAt = local_last_changed_at;
    LastChangedAt      = last_changed_at;
  }
}