projection;
strict ( 2 );
use draft;

define behavior for ZC_ITS_JE alias JournalEntry
{
  use create;
  use update;
  use delete;
  use association _Item { create; }

  use action Post;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
}

define behavior for ZC_ITS_JEITEM alias JournalEntryItem
{
  use update;
  use delete;
  use association _JournalEntry;
}