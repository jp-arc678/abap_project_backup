projection;
strict ( 2 );
use draft;

define behavior for ZC_ITS_JE //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action Activate;
  use action Discard;
  use action Edit;
  use action Resume;
  use action Prepare;

  use association _Item { create; }
}

define behavior for ZC_ITS_JEITEM //alias <alias_name>
{
  use update;
  use delete;

  use association _JournalEntry;
}