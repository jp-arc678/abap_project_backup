managed implementation in class zbp_i_its_costctr unique;
strict ( 2 );
with draft;

define behavior for ZI_ITS_COSTCTR alias CostCenter
persistent table zits_costctr
draft table zits_costctr_d
lock master total etag LastChangedAt
etag master LocalLastChangedAt
authorization master ( global )
{
  create;
  update;
  // no delete on purpose — Journal Entries will reference CostCenterID; use IsActive = ' ' to deactivate instead

  //--- field characteristics ---
  field ( mandatory : create, readonly : update ) CostCenterID;
  field ( mandatory ) CCName, BranchID, CCType;
  field ( readonly ) CreatedBy, CreatedAt, LocalLastChangedBy, LocalLastChangedAt, LastChangedAt;

  //--- determinations ---
  determination setDefaults on modify { create; }

  //--- validations ---
  validation validateCostCenterID on save { create;         field CostCenterID; }
  validation validateCCName       on save { create; update; field CCName; }
  validation validateBranch       on save { create; update; field BranchID; }
  validation validateCCType       on save { create; update; field CCType; }

  //--- draft actions ---
  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare
  {
    validation validateCostCenterID;
    validation validateCCName;
    validation validateBranch;
    validation validateCCType;
  }

  mapping for zits_costctr
  {
    CostCenterID       = cost_center_id;
    CCName             = cc_name;
    BranchID           = branch_id;
    CCType             = cc_type;
    IsActive           = is_active;
    CreatedBy          = created_by;
    CreatedAt          = created_at;
    LocalLastChangedBy = local_last_changed_by;
    LocalLastChangedAt = local_last_changed_at;
    LastChangedAt      = last_changed_at;
  }
}